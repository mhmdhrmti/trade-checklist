# Google Sheet that receives the trades (the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Service account credentials (see README → "Google Sheets setup").
# Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as "Editor".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key; keep the \n sequences, wrap in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
